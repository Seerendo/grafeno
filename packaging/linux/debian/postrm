#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
# Removing keeps the settings and the data; purging removes them, as
# Debian expects (`grafeno backup` first if they matter).
if [ "$1" = "purge" ]; then
    rm -rf /etc/grafeno /var/lib/grafeno /etc/apparmor.d/local/grafeno
    rm -rf /etc/systemd/system/grafeno.service.d /etc/systemd/system/grafeno@*.service.d
    echo "Grafeno: purged /etc/grafeno and /var/lib/grafeno (data folders chosen elsewhere are kept)."
fi
