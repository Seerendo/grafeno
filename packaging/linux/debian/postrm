#!/bin/sh
set -e
# The data in /var/lib/grafeno and the settings in /etc/grafeno are kept,
# even on purge: they may be the only copy of someone's memory.
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
if [ "$1" = "purge" ]; then
    echo "Grafeno: kept /var/lib/grafeno and /etc/grafeno; remove them by hand if you no longer need them."
fi
