# AppArmor profile of the Grafeno service. It has no attachment path: the
# systemd units select it (AppArmorProfile=-grafeno), so `grafeno` run by
# hand (setup, shell, backup, ...) is not confined. The service may read
# its settings, write its data folder, and use the network; nothing else.
# Data folders elsewhere go in local/grafeno (grafeno setup --data adds them).

abi <abi/3.0>,

include <tunables/global>

profile grafeno flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  network netlink raw,

  signal (receive) peer=unconfined,
  signal (receive) set=(term, int, kill, hup),

  /usr/bin/grafeno mr,

  /etc/grafeno/ r,
  /etc/grafeno/** r,

  /var/lib/grafeno/ rw,
  /var/lib/grafeno/** rwk,

  # The number of CPUs and the memory, for thread pools and caches.
  @{PROC}/@{pid}/** r,
  @{PROC}/sys/kernel/** r,
  @{PROC}/meminfo r,
  @{PROC}/cpuinfo r,
  @{PROC}/stat r,
  /sys/devices/system/cpu/** r,
  /sys/fs/cgroup/** r,

  include if exists <local/grafeno>
}
